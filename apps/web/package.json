{
  "name": "@header-auditor/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js dashboard for header-auditor: sign-in, sites and scan reports.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@header-auditor/api": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  }
}
