# Copy to .env and fill in for local development. Never commit .env.
# Values below are placeholders, not real credentials.
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api (all optional; defaults shown) ---
API_HOST=127.0.0.1
API_PORT=3001
# Only set to true behind a reverse proxy you control (honours X-Forwarded-For).
API_TRUST_PROXY=false
API_BODY_LIMIT_BYTES=1048576
API_REQUEST_TIMEOUT_MS=30000
API_SHUTDOWN_TIMEOUT_MS=10000
API_READINESS_TIMEOUT_MS=2000

# --- docker-compose.yml services (bound to 127.0.0.1 only) ---
POSTGRES_USER=header_auditor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=header_auditor
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# --- packages/db (Prisma) ---
# Must match the POSTGRES_* values above. URL-encode special characters in
# the password. Add ?sslmode=require when pointing at a remote database.
DATABASE_URL=postgresql://header_auditor:change-me-local-only@127.0.0.1:5432/header_auditor

# --- queue (roadmap step 15) ---
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379
