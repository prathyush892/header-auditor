# Copy to .env and fill in for local development. Never commit .env.
# Values below are placeholders, not real credentials.
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api (all optional; defaults shown) ---
API_HOST=127.0.0.1
API_PORT=3001
# Only set to true behind a reverse proxy you control (honours X-Forwarded-For).
API_TRUST_PROXY=false
API_BODY_LIMIT_BYTES=1048576
API_REQUEST_TIMEOUT_MS=30000
API_SHUTDOWN_TIMEOUT_MS=10000
API_READINESS_TIMEOUT_MS=2000
# Comma-separated browser origins allowed to send state-changing requests
# (CSRF defence). Must match the dashboard's URL exactly: scheme, host, port.
API_ALLOWED_ORIGINS=http://localhost:3000

# --- auth (apps/api) ---
# Secure cookies (and the __Host- prefix). Only set false for plain-http local
# development; the API refuses to start with false in production.
AUTH_COOKIE_SECURE=true
# Absolute session lifetime, and how long an unused session survives.
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_IDLE_MINUTES=720
# Login throttling: attempts per email address and per client IP per window.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_RATE_LIMIT_PER_IP=100

# --- sites (apps/api) ---
# Maximum number of sites one account can add.
SITES_MAX_PER_USER=50
# Allow IP addresses and localhost as site URLs. Only for local development and
# end-to-end tests against a mock server; the API refuses true in production.
SITES_ALLOW_PRIVATE_TARGETS=false

# --- scans (apps/api) ---
# Queued + running scans one account may have at once, across all its sites.
SCANS_MAX_ACTIVE_PER_USER=5
# A scan still queued/running after this many minutes is marked abandoned the
# next time someone scans that site, so a crashed worker can't block it.
SCANS_ACTIVE_WINDOW_MINUTES=15

# --- docker-compose.yml services (bound to 127.0.0.1 only) ---
POSTGRES_USER=header_auditor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=header_auditor
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# --- packages/db (Prisma) ---
# Must match the POSTGRES_* values above. URL-encode special characters in
# the password. Add ?sslmode=require when pointing at a remote database.
DATABASE_URL=postgresql://header_auditor:change-me-local-only@127.0.0.1:5432/header_auditor

# --- queue (apps/api producer, apps/worker consumer) ---
# Must match REDIS_PASSWORD above. Use rediss:// for TLS to a remote Redis.
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379
# Redis key prefix for the BullMQ queues.
QUEUE_PREFIX=header-auditor

# --- apps/worker (all optional except DATABASE_URL and REDIS_URL) ---
# Scans run at the same time in one worker process.
WORKER_CONCURRENCY=4
# Time budget for each phase of a scan (page fetch, then TLS/DNS/well-known).
WORKER_SCAN_TIMEOUT_MS=30000
# A running scan older than this is treated as orphaned and may be re-claimed.
# Must be more than 2 x WORKER_SCAN_TIMEOUT_MS.
WORKER_STALE_AFTER_SECONDS=300
# How long SIGTERM waits for running scans before exiting.
WORKER_SHUTDOWN_TIMEOUT_MS=60000
# Scan loopback/private addresses. Only for local development and e2e tests
# against a mock server; the worker refuses true in production.
WORKER_ALLOW_PRIVATE_TARGETS=false

# --- scheduler (apps/api: node apps/api/dist/schedules/main.js) ---
# Uses DATABASE_URL, REDIS_URL, QUEUE_PREFIX and the SCANS_* limits above, so
# scheduled scans obey the same limits as manual ones. All optional.
# How often to look for sites whose daily/weekly scan is due.
SCHEDULER_INTERVAL_SECONDS=60
# Sites read per query, and queries per tick (bounds the work of one tick).
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MAX_BATCHES_PER_TICK=10
# Retry delay when a run couldn't be queued (owner at their limit, Redis down).
SCHEDULER_RETRY_MINUTES=15
# How long SIGTERM waits for the current tick before exiting.
SCHEDULER_SHUTDOWN_TIMEOUT_MS=30000
