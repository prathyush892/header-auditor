      "expect": {
        "status": "pass",
        "score": 10,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "last token is unsafe",
      "headers": [["Referrer-Policy", "no-referrer, unsafe-url"]],
      "expect": {
        "status": "fail",
        "score": 0,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "unsafe-url",
      "headers": [["Referrer-Policy", "unsafe-url"]],
      "expect": {
        "status": "fail",
        "score": 0,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "origin leaks less but not safe",
      "headers": [["Referrer-Policy", "origin"]],
      "expect": {
        "status": "warn",
        "score": 5,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "no-referrer-when-downgrade",
      "headers": [["Referrer-Policy", "no-referrer-when-downgrade"]],
      "expect": {
        "status": "warn",
        "score": 5,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "uppercase safe value",
      "headers": [["Referrer-Policy", "SAME-ORIGIN"]],
      "expect": {
        "status": "pass",
        "score": 10,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "only commas",
      "headers": [["Referrer-Policy", ", ,"]],
      "expect": {
        "status": "warn",
        "score": 5,
        "weight": 10
      }
    }
  ]
}
