        "status": "fail",
        "score": 0,
        "weight": 10
      }
    },
    {
      "check": "content-type-options",
      "name": "unexpected value",
      "headers": [["X-Content-Type-Options", "sniff"]],
      "expect": {
        "status": "warn",
        "score": 3,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "missing",
      "headers": [],
      "expect": {
        "status": "warn",
        "score": 5,
        "weight": 10
      }
    },
    {
      "check": "referrer-policy",
      "name": "safe fallback list uses last",
